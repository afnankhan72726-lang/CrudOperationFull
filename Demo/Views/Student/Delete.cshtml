@model Demo.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-4">
    <h2>Delete Student</h2>
    <h3 class="text-danger">Are you sure you want to delete this record?</h3>
    <hr />

    <div>
        <h4>Student Details</h4>
        <dl class="row mt-3">
            <dt class="col-sm-2 font-weight-bold">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>

            <dt class="col-sm-2 font-weight-bold">
                @Html.DisplayNameFor(model => model.Age)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Age)
            </dd>
        </dl>

        <!-- Yahan method="post" lagana zaroori hai -->
        <form asp-action="Delete" method="post">
            <!-- Hidden ID taaki pata chale kisko delete karna hai -->
            <input type="hidden" asp-for="Id" />

            <div class="form-group mt-3">
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>